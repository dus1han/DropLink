{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DropLink",
  "mainBinaryName": "DropLink",
  "version": "1.0.0",
  "identifier": "app.droplink.desktop",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1RERDODY0RkJBRDZGMkQKUldRdGI2MzdaTWpkWlJaSml4QVkwaElUc3FNOXR2UkpqdmViaXNBelFRZHpaV0hVeEhPTHhUVWYK",
      "endpoints": ["https://github.com/dus1han/DropLink/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DropLink",
        "width": 1240,
        "height": 720,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0c0d10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "publisher": "Dushan Fernando",
    "copyright": "© 2026 Dushan Fernando",
    "shortDescription": "Send anything between your computers",
    "longDescription": "DropLink sends files, folders, text and clipboard contents between macOS and Windows computers over an end-to-end encrypted, mutually authenticated connection — no cloud storage involved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "./windows/hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["./windows/firewall.wxs"],
        "componentGroupRefs": ["DropLinkFirewall"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
